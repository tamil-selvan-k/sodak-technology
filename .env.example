# ── Database (Supabase) ───────────────────────────────────────────────────────
# Pooler (pgbouncer, port 6543) — used at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (port 5432) — used by prisma migrate deploy only
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
NEXT_PUBLIC_SITE_URL="https://sodakedutech.in"

# ── AWS S3 (media storage) ────────────────────────────────────────────────────
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="sodakedutech-media"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
# Optional CloudFront CDN domain (without https://)
AWS_CLOUDFRONT_DOMAIN=""

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY="re_your_key"
RESEND_FROM="SODAK Technology <hello@sodakedutech.in>"
NOTIFICATION_EMAIL="admin@sodakedutech.in"

# ── Cloudflare Turnstile (spam protection) ────────────────────────────────────
# Get keys from: https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY="your-secret-key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-site-key"

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

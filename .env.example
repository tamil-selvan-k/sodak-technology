# ── Database (Supabase PostgreSQL) ──────────────────
# Pooler URL (port 6543, transaction mode) — used at runtime via Prisma
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL (port 5432) — used by `prisma migrate deploy` (DDL requires direct connection)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── NextAuth.js v5 ───────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# ── AWS S3 ───────────────────────────────────────────
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="sodakedutech-media"
# Optional: CloudFront distribution domain — leave blank to fall back to direct S3 URLs
AWS_CLOUDFRONT_DOMAIN=""

# ── Resend (email) ───────────────────────────────────
RESEND_API_KEY="re_your_resend_key"
RESEND_FROM="SoDak EduTech <hello@sodakedutech.in>"
NOTIFICATION_EMAIL="team@sodakedutech.in"

# ── Upstash Redis (rate limiting) ────────────────────
UPSTASH_REDIS_REST_URL="https://your-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# ── Cloudflare Turnstile (spam protection) ───────────
TURNSTILE_SECRET_KEY="your-turnstile-secret"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://sodakedutech.in"
